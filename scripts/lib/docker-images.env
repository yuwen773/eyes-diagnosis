# shellcheck shell=bash
# Single source of truth for the Docker images used by local test entry points.
#
# CI `services:` blocks cannot source this file (Actions YAML is static), so
# scripts/tests/test-docker-image-pins.sh asserts that verify.yml and
# docker-compose.yml carry the same tags as this file. Change all three together.
#
# All tags below are exact minor/patch versions that already exist on the local
# Docker host, so `verify.sh` never needs to re-pull them. Keep it that way:
# a moving tag (`mysql:8`, `redis:7-alpine`) makes local runs pull and makes CI
# non-reproducible.

MYSQL_IMAGE="${MYSQL_IMAGE:-mysql:8.0.36}"
REDIS_IMAGE="${REDIS_IMAGE:-redis:7.2.4}"
CHROMA_IMAGE="${CHROMA_IMAGE:-ghcr.io/chroma-core/chroma:1.0.0}"
# Tiny image for the lifecycle acceptance tests (no network services needed).
EYE_TEST_IMAGE="${EYE_TEST_IMAGE:-busybox:1.36}"
