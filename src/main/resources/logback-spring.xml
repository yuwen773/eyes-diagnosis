<?xml version="1.0" encoding="UTF-8"?>
<!-- PR-12.1: unified log correlation. Every line carries the MDC quadruple
     workflowId / segment / jobId / traceId so one segment execution can be traced end to end. -->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="CORRELATION"
              value="{workflowId=%X{workflowId:-},segment=%X{segment:-},jobId=%X{jobId:-},traceId=%X{traceId:-}}"/>
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr(${PID:- }){magenta} %clr(---){faint} %clr([%15.15t]){faint} %clr(%-40.40logger{39}){cyan} %clr(:){faint} ${CORRELATION} %m%n%wEx"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
