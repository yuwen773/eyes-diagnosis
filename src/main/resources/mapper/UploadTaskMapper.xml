<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.csust.eyediagnosis.mapper.UploadTaskMapper">

    <resultMap id="BaseResultMap" type="com.csust.eyediagnosis.model.entity.UploadTask">
        <id column="id" property="id" />
        <result column="taskId" property="taskId" />
        <result column="userId" property="userId" />
        <result column="objectKey" property="objectKey" />
        <result column="status" property="status" />
        <result column="retryCount" property="retryCount" />
        <result column="lastError" property="lastError" />
        <result column="createTime" property="createTime" />
        <result column="updateTime" property="updateTime" />
    </resultMap>

    <select id="selectActiveKeys" resultType="java.lang.String">
        SELECT objectKey
        FROM t_upload_task
        WHERE userId = #{userId}
          AND status IN (1, 3)
    </select>

    <insert id="insertPending" parameterType="com.csust.eyediagnosis.model.entity.UploadTask">
        INSERT INTO t_upload_task (taskId, userId, objectKey, status, retryCount, createTime, updateTime)
        VALUES (#{taskId}, #{userId}, #{objectKey}, #{status}, #{retryCount}, NOW(), NOW())
    </insert>

</mapper>