# Copy outside the image. These services connect to EXISTING infrastructure.
# Use host.docker.internal for host services or a reachable private hostname.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3307
MYSQL_DATABASE=diagnosis
MYSQL_USER=eyeuser
MYSQL_PASSWORD=
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_DB=8
REDIS_PASSWORD=
CHROMA_HOST=host.docker.internal
CHROMA_PORT=8000
CHROMA_COLLECTION=diagnosis-knowledge
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
CORS_ALLOWED_ORIGINS=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
CHAT_MODEL=qwen3-vl-plus
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
COS_HOST=
MODEL_WEIGHTS_PATH=
MODEL_WEIGHTS_SHA256=
MODEL_REGISTRY_PATH=/opt/eye-model/registry.json
MODEL_CALIBRATION_PATH=/opt/eye-model/efficientnet_b4_temperature.json
