  "diagnosis": {
    "categories": {
      "normal": "正常",
      "amd": "年龄相关性黄斑变性",
      "cataract": "白内障",
      "diabetes": "糖尿病",
      "glaucoma": "青光眼",
      "hypertension": "高血压",
      "myopia": "近视",
      "other": "其他"
    },
    "recommendations": {
      "normal": "正常",
      "amd": "抗VEGF药物注射治疗，如雷珠单抗、艾伐仑单抗等\n定期眼科检查，监测病情变化\n合理饮食，补充含抗氧化剂的食物（如深绿色蔬菜、橙色水果）\n戒烟，控制血压和血脂\n佩戴防蓝光眼镜，减少蓝光伤害",
      "cataract": "早期可通过更换眼镜度数缓解症状\n中晚期主要采用手术治疗，包括超声乳化白内障吸除术和人工晶体植入\n术后需按医嘱使用抗生素和激素眼药水\n避免强光照射，必要时佩戴太阳镜\n控制血糖，避免糖尿病加速白内障发展",
      "diabetes": "严格控制血糖、血压和血脂\n定期进行眼底检查，早期发现视网膜病变\n激光光凝治疗，控制视网膜新生血管\n抗VEGF药物玻璃体内注射\n严重增殖期可能需要玻璃体视网膜手术",
      "glaucoma": "药物治疗：降眼压滴眼液（如β受体阻滞剂、前列腺素类药物）\n激光治疗：选择性激光小梁成形术(SLT)或激光周边虹膜切除术\n手术治疗：小梁切除术、青光眼引流管植入术等\n避免剧烈运动和情绪波动，保持规律生活作息\n长期定期随访，监测眼压变化",
      "hypertension": "严格控制血压，按时服用降压药物\n低盐低脂饮食，控制体重\n戒烟限酒，规律运动\n定期眼科检查，监测视网膜血管变化\n严重视网膜病变可能需要激光光凝治疗",
      "myopia": "科学验光，正确佩戴眼镜或隐形眼镜\n低度近视儿童可考虑角膜塑形镜或阿托品滴眼液控制近视发展\n使用电子设备时注意休息（20-20-20法则：每20分钟远眺20英尺外物体20秒）\n保持充足光线，正确阅读姿势\n高度近视需定期检查眼底，监测视网膜变性风险",
      "other": "其他"
    }
  },
